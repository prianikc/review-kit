#!/usr/bin/env bash
set -euo pipefail

number=""; head_ref=""; head_sha=""; base_ref=""; own=0
while [ $# -gt 0 ]; do
  case "$1" in
    --number) number="${2:-}"; shift 2 ;;
    --head-ref) head_ref="${2:-}"; shift 2 ;;
    --head-sha) head_sha="${2:-}"; shift 2 ;;
    --base-ref) base_ref="${2:-}"; shift 2 ;;
    --own) own=1; shift ;;
    *) echo "switch-pr: неизвестный аргумент $1" >&2; exit 64 ;;
  esac
done
[ -n "$number" ] && [ -n "$head_ref" ] && [ -n "$head_sha" ] && [ -n "$base_ref" ] || { echo "switch-pr: нужны --number, --head-ref, --head-sha, --base-ref" >&2; exit 64; }

[ -z "$(git status --porcelain -uno --ignore-submodules=all)" ] || { echo "switch-pr: в дереве изменены отслеживаемые файлы — сначала stash" >&2; exit 5; }

busy=$(git worktree list --porcelain | awk -v b="refs/heads/$head_ref" '$1=="worktree"{p=$2} $1=="branch" && $2==b {print p}')
current_root=$(git rev-parse --show-toplevel)
if [ -n "$busy" ] && [ "$busy" != "$current_root" ]; then
  echo "switch-pr: ветка $head_ref занята worktree $busy" >&2; exit 7
fi

switch_or_fail() {
  local err
  err=$(git switch -q "$@" 2>&1) || { echo "switch-pr: git switch не удался: $err" >&2; exit 8; }
}

detached=false
target=""
if git ls-remote --exit-code origin "refs/heads/$head_ref" >/dev/null 2>&1; then
  git fetch -q origin "+refs/heads/$head_ref:refs/remotes/origin/$head_ref"
  target=$(git rev-parse "origin/$head_ref")
else
  git update-ref -d "refs/remotes/origin/$head_ref" 2>/dev/null || true
fi
if [ "$target" != "$head_sha" ]; then
  git fetch -q origin "refs/pull/$number/head" 2>/dev/null || { echo "switch-pr: на сервере нет ни ветки $head_ref, ни refs/pull/$number/head" >&2; exit 9; }
  target=$(git rev-parse FETCH_HEAD)
  [ "$target" = "$head_sha" ] || { echo "switch-pr: PR $number изменился во время подготовки (ожидался $head_sha)" >&2; exit 11; }
  detached=true
fi

final="$target"
if [ "$detached" = false ] && [ "$own" -eq 1 ] && git rev-parse -q --verify "refs/heads/$head_ref" >/dev/null; then
  local_sha=$(git rev-parse "refs/heads/$head_ref")
  if git merge-base --is-ancestor "$target" "$local_sha"; then
    final="$local_sha"
  elif ! git merge-base --is-ancestor "$local_sha" "$target"; then
    echo "switch-pr: своя ветка $head_ref разошлась с origin — разберитесь вручную" >&2; exit 6
  fi
fi

git fetch -q origin "+refs/heads/$base_ref:refs/remotes/origin/$base_ref" 2>/dev/null || true
base_tip="origin/$base_ref"
fallback=false
if ! git rev-parse -q --verify "refs/remotes/$base_tip" >/dev/null; then
  base_tip="origin/main"; fallback=true
  git fetch -q origin "+refs/heads/main:refs/remotes/origin/main" 2>/dev/null \
    || { echo "switch-pr: на сервере нет ни ветки $base_ref, ни main" >&2; exit 12; }
fi
if git merge-base --is-ancestor "$final" "$base_tip"; then
  merge=""
  for candidate in $(git rev-list --first-parent --merges --reverse "$final..$base_tip"); do
    if git merge-base --is-ancestor "$final" "$candidate^2"; then merge="$candidate"; break; fi
  done
  [ -n "$merge" ] || { echo "switch-pr: PR уже в $base_tip без merge-коммита — базу ревью не определить" >&2; exit 10; }
  base=$(git merge-base "$merge^1" "$final")
else
  base=$(git merge-base "$base_tip" "$final")
fi

if [ "$detached" = true ]; then
  switch_or_fail --detach "$target"
elif [ "$own" -eq 0 ]; then
  switch_or_fail -C "$head_ref" "origin/$head_ref"
elif ! git rev-parse -q --verify "refs/heads/$head_ref" >/dev/null; then
  switch_or_fail -c "$head_ref" "origin/$head_ref"
else
  switch_or_fail "$head_ref"
  [ "$final" = "$(git rev-parse HEAD)" ] || git merge -q --ff-only "origin/$head_ref"
fi

printf '{"head": "%s", "base": "%s", "detached": %s, "baseFallback": %s}\n' "$(git rev-parse HEAD)" "$base" "$detached" "$fallback"
