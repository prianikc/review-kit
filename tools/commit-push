#!/usr/bin/env bash
set -euo pipefail

branch=""; base_head=""; message=""; paths=()
while [ $# -gt 0 ]; do
  case "$1" in
    --branch) branch="$2"; shift 2 ;;
    --base-head) base_head="$2"; shift 2 ;;
    --message) message="$2"; shift 2 ;;
    --) shift; paths=("$@"); break ;;
    *) echo "commit-push: неизвестный аргумент $1" >&2; exit 64 ;;
  esac
done
[ -n "$branch" ] && [ -n "$base_head" ] && [ -n "$message" ] && [ ${#paths[@]} -gt 0 ] \
  || { echo "commit-push: нужны --branch, --base-head, --message и пути после --" >&2; exit 64; }

top=$(git rev-parse --show-toplevel)
prefix=$(git rev-parse --show-prefix)
rules_hook="${RK_COMMIT_RULES_HOOK:-$top/.claude/ai-dev-kit/rules/hooks/enforce-commit-rules.js}"

rooted=()
for path in "${paths[@]}"; do rooted+=("${prefix}${path#./}"); done
cd "$top"

[ -f "$rules_hook" ] || { echo "commit-push: хук правил коммита не найден: $rules_hook (подмодуль ai-dev-kit не инициализирован?)" >&2; exit 2; }

case "$message" in
  *$'\n'*|*$'\r'*) echo 'commit-push: сообщение — одна строка, без переводов строки' >&2; exit 2 ;;
esac
case "$message" in
  *'"'*|*'$'*|*'`'*|*'\'*) echo 'commit-push: в сообщении нельзя использовать ", $, ` и \' >&2; exit 2 ;;
esac
[ "$message" = "$(printf '%s' "$message" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" ] \
  || { echo 'commit-push: пробел в начале или в конце сообщения' >&2; exit 2; }

current=$(git rev-parse --abbrev-ref HEAD)
[ "$current" = "$branch" ] || { echo "commit-push: дерево на ветке $current, а подтверждена $branch" >&2; exit 3; }

check_message() {
  python3 -c 'import json,sys; print(json.dumps({"tool_name":"Bash","tool_input":{"command":"git commit -m \""+sys.argv[1]+"\""}}))' "$message" \
    | node "$rules_hook"
}

head=$(git rev-parse HEAD)

if [ "$head" = "$base_head" ]; then
  check_message || { echo "commit-push: сообщение не прошло правила коммита" >&2; exit 2; }

  for path in "${rooted[@]}"; do
    case "$path" in
      :*|*'*'*|*'?'*|*'['*) echo "commit-push: путь $path — pathspec или glob, нужен путь к файлу" >&2; exit 4 ;;
    esac
    if [ -d "$path" ]; then
      echo "commit-push: путь $path — каталог, нужен путь к файлу" >&2; exit 4
    fi
    if [ ! -f "$path" ] && ! git cat-file -e "HEAD:$path" 2>/dev/null; then
      echo "commit-push: путь $path — не файл и не отслеживаемый удалённый файл" >&2; exit 4
    fi
  done

  changed=$(git diff --name-only HEAD) || { echo 'commit-push: git diff не удался' >&2; exit 7; }
  foreign=$(printf '%s\n' "$changed" | grep -vxF -f <(printf '%s\n' "${rooted[@]}") || true)
  if [ -n "$foreign" ]; then
    printf 'commit-push: в дереве изменены файлы вне подтверждённого списка:\n%s\n' "$foreign" >&2
    exit 4
  fi

  present=()
  for path in "${rooted[@]}"; do
    if [ -f "$path" ]; then present+=("$path"); else git rm -q --cached --ignore-unmatch -- "$path"; fi
  done
  [ ${#present[@]} -eq 0 ] || git add -- "${present[@]}"
  extra=$(git diff --cached --name-only | grep -vxF -f <(printf '%s\n' "${rooted[@]}") || true)
  if [ -n "$extra" ]; then
    git reset -q -- "${rooted[@]}" $extra
    printf 'commit-push: в индекс попали файлы вне подтверждённого списка:\n%s\n' "$extra" >&2
    exit 4
  fi
  if git diff --cached --quiet; then
    echo "commit-push: в подтверждённых путях нечего коммитить" >&2
    exit 6
  fi
  git commit -q -m "$message"
elif [ "$(git rev-parse HEAD^)" != "$base_head" ] || [ "$(git log -1 --format=%s)" != "$message" ]; then
  echo "commit-push: head $head не продолжает base $base_head коммитом раунда с подтверждённым сообщением" >&2
  exit 3
fi

git push -q origin "HEAD:refs/heads/$branch" \
  || { echo "commit-push: push отклонён (non-fast-forward или сеть); --force не используется" >&2; exit 5; }
echo "review-kit:commit-push:ok"
