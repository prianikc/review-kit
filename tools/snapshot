#!/usr/bin/env bash
set -euo pipefail
[ "${1:-}" = "--" ] && shift
[ $# -gt 0 ] || { echo "snapshot: нужны пути раунда после --" >&2; exit 64; }
index="$(mktemp)"
trap 'rm -f "$index"' EXIT
cp "$(git rev-parse --git-path index)" "$index"
GIT_INDEX_FILE="$index" git add -A -- "$@"
tree=$(GIT_INDEX_FILE="$index" git write-tree)
git commit-tree "$tree" -p HEAD -m "review-kit snapshot"
